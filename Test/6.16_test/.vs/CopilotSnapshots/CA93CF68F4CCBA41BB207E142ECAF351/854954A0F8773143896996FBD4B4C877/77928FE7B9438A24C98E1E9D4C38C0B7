using System.Text;

namespace _6._16_test.Factory
{
    /// <summary>
    /// DESIGN PATTERN: FACTORY
    /// Dùng để tạo ra các loại HTTP Response khác nhau (HTML hoặc Redirect) một cách chuyên nghiệp và tập trung.
    /// Giúp code ở lớp xử lý chính sạch sẽ hơn, chỉ cần gọi phương thức tạo mà không quan tâm cấu trúc raw của HTTP Header.
    /// </summary>
    internal class ResponseFactory
    {
        // Tạo phản hồi trả về nội dung HTML cho trình duyệt
        public static byte[] Html(string body)
        {
            string response = "HTTP/1.1 200 OK\r\n";
            response += "Content-Type: text/html; charset=utf-8\r\n";
            response += $"Content-Length: {Encoding.UTF8.GetByteCount(body)}\r\n";
            response += "\r\n";
            response += body;

            return Encoding.UTF8.GetBytes(response);
        }

        // Tạo phản hồi yêu cầu trình duyệt chuyển hướng (Redirect)
        public static byte[] Redirect(string location)
        {
            string response = "HTTP/1.1 302 Found\r\n";
            response += $"Location: {location}\r\n";
            response += "\r\n";

            return Encoding.ASCII.GetBytes(response);
        }
    }
}
