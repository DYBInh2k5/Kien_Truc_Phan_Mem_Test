using System.Net;

namespace SA_TEST.Utils
{
    // Lớp hỗ trợ các thao tác bóc tách dữ liệu HTTP thủ công
    internal class HttpHelper
    {
        // Phân tích dữ liệu từ Body của Request (Dành cho POST form)
        public static Dictionary<string, string> ParseFormData(string requestData)
        {
            var dict = new Dictionary<string, string>();
            string[] separator = { "\r\n\r\n" };
            // Tách phần Header và Body bằng dòng trống kép
            var parts = requestData.Split(separator, StringSplitOptions.None);
            if (parts.Length < 2) return dict;

            var body = parts[1].Trim('\0');
            var pairs = body.Split('&'); // Tách các cặp key=value bằng dấu &
            foreach (var pair in pairs)
            {
                var kv = pair.Split('=');
                if (kv.Length == 2) 
                    // Giải mã URL (ví dụ: %20 -> khoảng trắng)
                    dict[WebUtility.UrlDecode(kv[0])] = WebUtility.UrlDecode(kv[1]);
            }
            return dict;
        }

        // Tìm giá trị của một Cookie cụ thể trong Request
        public static string GetCookie(string requestData, string cookieName)
        {
            var lines = requestData.Split("\r\n");
            foreach (var line in lines)
            {
                if (line.StartsWith("Cookie:"))
                {
                    // Tách các cookie bằng dấu chấm phẩy
                    var cookies = line.Substring(7).Split(';');
                    foreach (var c in cookies)
                    {
                        var kv = c.Trim().Split('=');
                        if (kv.Length == 2 && kv[0] == cookieName) return kv[1];
                    }
                }
            }
            return null;
        }
    }
}
