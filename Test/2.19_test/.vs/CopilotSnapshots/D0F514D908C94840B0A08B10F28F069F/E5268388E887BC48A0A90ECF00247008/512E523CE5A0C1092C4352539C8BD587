using System.Net;
using System.Net.Sockets;
using System.Text;
using SA_TEST.Controllers;
using SA_TEST.Services;
using SA_TEST.Utils;

namespace SA_TEST
{
    class Program
    {
        static void Main(string[] args)
        {
            // Thiết lập địa chỉ IP (bất kỳ) và Port 8080 cho Server
            IPEndPoint serverInfor = new IPEndPoint(IPAddress.Any, 8080);
            
            // Khởi tạo Socket lắng nghe kết nối TCP
            Socket serverListen = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
            serverListen.Bind(serverInfor);
            serverListen.Listen(10); // Lắng nghe tối đa 10 kết nối trong hàng đợi
            Console.WriteLine("Server running on http://localhost:8080");

            while (true)
            {
                // Chấp nhận một client kết nối tới
                Socket staff = serverListen.Accept();
                // Tạo một Thread mới để xử lý song song, tránh treo Server
                new Thread(HandleClient).Start(staff);
            }
        }

        static void HandleClient(object obj)
        {
            Socket staff = (Socket)obj;
            try
            {
                // Tăng buffer để nhận được đầy đủ gói tin lớn
                byte[] bytes = new byte[8192];
                int bytesRec = staff.Receive(bytes);
                if (bytesRec == 0) return;

                // Chuyển dữ liệu sang UTF8 để xử lý tiếng Việt và ký tự đặc biệt
                string requestData = Encoding.UTF8.GetString(bytes, 0, bytesRec);
                string[] lines = requestData.Split("\r\n");
                if (lines.Length == 0) return;

                // Phân tích dòng đầu tiên (VD: GET /login HTTP/1.1)
                string[] firstLine = lines[0].Split(' ');
                if (firstLine.Length < 2) return;

                string method = firstLine[0]; // GET hoặc POST
                string url = firstLine[1];    // Đường dẫn (/)

                string responseBody = "";
                string contentType = "text/html";
                string extraHeaders = "";
                int statusCode = 200;
                string statusText = "OK";

                // Đọc Cookie từ Request để xác định User đã đăng nhập chưa
                string currentUser = HttpHelper.GetCookie(requestData, "token");

                if (method == "GET")
                {
                    // Routing thủ công cho các request GET
                    if (url == "/") responseBody = HomeController.Index();
                    else if (url == "/login") responseBody = LoginController.LoginPage();
                    else if (url == "/style.css") { 
                        contentType = "text/css"; // Trả về file CSS để trang web đẹp hơn
                        responseBody = File.Exists("Html/style.css") ? File.ReadAllText("Html/style.css") : ""; 
                    }
                    else if (url == "/chat")
                    {
                        // Kiểm tra quyền: Chưa login thì chuyển hướng (302) về /login
                        if (string.IsNullOrEmpty(currentUser)) { statusCode = 302; statusText = "Found"; extraHeaders = "Location: /login\r\n"; }
                        else responseBody = ChatController.ChatList();
                    }
                    else if (url.StartsWith("/chat/"))
                    {
                        if (string.IsNullOrEmpty(currentUser)) { statusCode = 302; statusText = "Found"; extraHeaders = "Location: /login\r\n"; }
                        else { 
                            int.TryParse(url.Substring(6), out int id); 
                            responseBody = ChatController.ChatRoom(id); 
                        }
                    }
                }
                else if (method == "POST")
                {
                    // Lấy dữ liệu từ body của Request (VD: username=nntu&password=...)
                    var formData = HttpHelper.ParseFormData(requestData);
                    
                    if (url == "/login")
                    {
                        var users = JsonService.getInstance().getUsers();
                        // So khớp thông tin đăng nhập
                        var user = users.FirstOrDefault(u => u.username == (formData.ContainsKey("username") ? formData["username"] : "") 
                                                        && u.password == (formData.ContainsKey("password") ? formData["password"] : ""));
                        if (user != null) { 
                            // Login thành công: Chuyển hướng và đặt Cookie token
                            statusCode = 302; statusText = "Found"; 
                            extraHeaders = "Location: /chat\r\nSet-Cookie: token=" + user.username + "; Path=/\r\n"; 
                        }
                        else responseBody = "<h1>Login Failed</h1><a href='/login'>Try again</a>";
                    }
                    else if (url.StartsWith("/chat/"))
                    {
                        int.TryParse(url.Substring(6), out int id);
                        if (formData.ContainsKey("message"))
                        {
                            // Thêm tin nhắn mới vào phòng chat
                            ChatService.AddMessage(id, currentUser ?? "Anonymous", formData["message"]);
                        }
                        // Gửi xong thì redirect lại chính phòng đó để thấy tin nhắn mới
                        statusCode = 302; statusText = "Found"; extraHeaders = $"Location: /chat/{id}\r\n";
                    }
                }

                // Xây dựng chuỗi Response theo đúng chuẩn HTTP/1.1
                string response = $"HTTP/1.1 {statusCode} {statusText}\r\n" +
                                  $"Content-Type: {contentType}\r\n" +
                                  $"Content-Length: {Encoding.UTF8.GetByteCount(responseBody)}\r\n" +
                                  extraHeaders + "\r\n" + responseBody;

                // Gửi dữ liệu về cho trình duyệt
                staff.Send(Encoding.UTF8.GetBytes(response));
            }
            catch (Exception ex) { Console.WriteLine("Error: " + ex.Message); }
            finally { staff.Close(); } // Đóng socket để giải phóng tài nguyên
        }
    }
}
