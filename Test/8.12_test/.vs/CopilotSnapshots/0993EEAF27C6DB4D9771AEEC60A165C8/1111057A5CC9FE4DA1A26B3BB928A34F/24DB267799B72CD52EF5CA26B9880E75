using System.Text.Json;

namespace _8._12_test
{
    /// <summary>
    /// DESIGN PATTERN: SINGLETON
    /// ??m b?o t?p accounts.json ch? ???c ??c 1 l?n duy nh?t vào b? nh?.
    /// Giúp ti?t ki?m tài nguyên I/O và ??ng b? d? li?u ng??i dùng trong su?t vòng ??i Server.
    /// </summary>
    internal class JsonAccountSingleton
    {
        private static JsonAccountSingleton instance = null;
        public List<User> users;

        private JsonAccountSingleton()
        {
            string baseDir = AppDomain.CurrentDomain.BaseDirectory;
            // Tìm thư mục chứa accounts.json bằng cách đi ngược lên từ bin/Debug/...
            string filePath = Path.Combine(baseDir, "data", "accounts.json");
            
            if (!File.Exists(filePath))
            {
                // Thử tìm ở thư mục dự án nếu đang chạy trong môi trường phát triển
                string projectDir = Directory.GetParent(baseDir).Parent.Parent.Parent.FullName;
                filePath = Path.Combine(projectDir, "8.12_test", "data", "accounts.json");
            }

            if (!File.Exists(filePath))
            {
                // Fallback cuối cùng: thư mục hiện tại
                filePath = Path.Combine(Directory.GetCurrentDirectory(), "8.12_test", "data", "accounts.json");
            }
            
            if (File.Exists(filePath))
            {
                string json = File.ReadAllText(filePath);
                users = JsonSerializer.Deserialize<List<User>>(json);
                Console.WriteLine($"Loaded users from: {filePath}");
            }
            else
            {
                users = new List<User>();
                Console.WriteLine("Warning: accounts.json NOT FOUND!");
            }
        }

        /// <summary>
        /// Ph??ng th?c truy c?p duy nh?t ?? l?y th?c th? (Instance) c?a l?p.
        /// </summary>
        public static JsonAccountSingleton getInstance()
        {
            if (instance == null)
            {
                instance = new JsonAccountSingleton();
            }
            return instance;
        }
    }
}