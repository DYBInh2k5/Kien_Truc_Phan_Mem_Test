        /// <summary>
        /// X? lý POST /login
        /// - Parse body (form urlencoded) -> ki?m tra username/password so v?i danh sách users
        /// - N?u xác th?c thành công: t?o token, tr? header Set-Cookie và redirect v? /chat
        /// - N?u th?t b?i: tr? l?i trang login kèm thông báo l?i
        /// </summary>
        private static void HandleLogin(Socket staff, string body)
        {
            var data = ParseQueryString(body);
            string user = data.ContainsKey("username") ? data["username"] : "";
            string pass = data.ContainsKey("password") ? data["password"] : "";

            var users = JsonAccountSingleton.getInstance().users;
            var authenticatedUser = users.Find(u => u.username == user && u.password == pass);

            if (authenticatedUser != null)
            {
                // Thành công: t?o token và redirect v? /chat, kèm Set-Cookie
                string token = Guid.NewGuid().ToString();
                SendRedirect(staff, "/chat", $"token={token}; Path=/; HttpOnly; Max-Age=3600");
            }
            else
            {
                SendResponse(staff, GetLoginHtml("Login failed. Please try again."));
            }
        }

        // Trang danh sách phòng chat (/chat)
        private static string GetChatRoomsHtml()
        {
            var builder = new ChatBuilder();
            builder.setTitle("Chat Rooms");
            string bodyHtml = "<ul class='room-list'>"; // danh sách phòng
            foreach (var room in rooms)
            {
                bool isOnline = room.IsOnline();
                string status = isOnline ? "<span class='online'>ONLINE</span>" : "<span class='offline'>OFFLINE</span>";
                bodyHtml += $"<li class='room-item'><a href='/chat/{room.Id}'>{room.Name}</a> - {status}</li>";
            }
            bodyHtml += "</ul>";
            return builder.setBody(bodyHtml).build();
        }

        /// <summary>
        /// X? lý GET /chat/{id}
        /// - L?y phòng theo id, hi?n th? l?ch s? tin nh?n (theo th? t? th?i gian) và form g?i tin
        /// - N?u phòng offline thì l?ch s? ?ã b? xóa b?i ChatRoom.IsOnline()
        /// </summary>
        private static void HandleGetChatRoom(Socket staff, string path)
        {
            int roomId = int.Parse(path.Replace("/chat/", ""));
            var room = rooms.Find(r => r.Id == roomId);
            if (room != null)
            {
                room.IsOnline(); // Cập nhật trạng thái
                var builder = new ChatBuilder();
                builder.setTitle(room.Name);
                
                // Sử dụng addMessage của Builder thay vì cộng chuỗi thủ công
                foreach (var msg in room.Messages)
                {
                    builder.addMessage(msg);
                }
                
                // Sử dụng addInputForm của Builder
                builder.addInputForm(room.Id);

                SendResponse(staff, builder.build());
            }
            else
            {
                SendResponse(staff, "<h1>Room not found</h1>");
            }
        }

        /// <summary>
        /// X? lý POST /chat/{id}
        /// - L?y n?i dung message t? body, decode và thêm vào danh sách tin nhắn c?a phòng
        /// - C?p nh?t LastActivity ?? phòng ???c ?ánh d?u online
        /// - Redirect v? GET /chat/{id} ?? hi?n th? l?i trang
        /// </summary>
        private static void HandlePostChatRoom(Socket staff, string path, string body, string cookie)
        {
            int roomId = int.Parse(path.Replace("/chat/", ""));
            var room = rooms.Find(r => r.Id == roomId);
            var data = ParseQueryString(body);
            string messageContent = data.ContainsKey("message") ? data["message"] : "";

            if (room != null && !string.IsNullOrEmpty(messageContent))
            {
                // ? bài lab này, username ??n gi?n l?y t? cookie token có hay không
                string user = "Guest";
                if (!string.IsNullOrEmpty(cookie) && cookie.Contains("token=")) user = "User";

                room.Messages.Add(new Message
                {
                    Username = user,
                    Content = HttpUtility.UrlDecode(messageContent),
                    Timestamp = DateTime.Now
                });
                room.LastActivity = DateTime.Now;
                SendRedirect(staff, $"/chat/{roomId}");
            }
        }

        /// <summary>
        /// G?i ph?n h?i HTTP chu?n v? Browser bao g?m: Status line, Headers và Body.
        /// N?u có cookie, thêm header Set-Cookie.
        /// </summary>
        private static void SendResponse(Socket staff, string body, string status = "200 OK", string cookie = null)
        {
            string response = $"HTTP/1.1 {status}\r\n";
            response += "Content-Type: text/html; charset=UTF-8\r\n";
            response += $"Content-Length: {Encoding.UTF8.GetByteCount(body)}\r\n";
            if (!string.IsNullOrEmpty(cookie)) response += $"Set-Cookie: {cookie}\r\n";
            response += "Connection: close\r\n";
            response += "\r\n";
            response += body;

            staff.Send(Encoding.UTF8.GetBytes(response));
            staff.Close();
        }

        /// <summary>
        /// G?i header 302 Found ?? trình duy?t t? ??ng chuy?n h??ng.
        /// N?u có cookie, thêm header Set-Cookie.
        /// </summary>
        private static void SendRedirect(Socket staff, string location, string cookie = null)
        {
            string response = "HTTP/1.1 302 Found\r\n";
            response += $"Location: {location}\r\n";
            if (!string.IsNullOrEmpty(cookie)) response += $"Set-Cookie: {cookie}\r\n";
            response += "Connection: close\r\n\r\n";

            staff.Send(Encoding.UTF8.GetBytes(response));
            staff.Close();
        }

        /// <summary>
        /// Parse chu?i query string d?ng key1=val1&key2=val2 thành Dictionary.
        /// Giá tr? ???c URL-decode.
        /// </summary>
        private static Dictionary<string, string> ParseQueryString(string query)
        {
            var dict = new Dictionary<string, string>();
            foreach (var part in query.Split('&'))
            {
                var kv = part.Split('=');
                if (kv.Length == 2) dict[kv[0]] = HttpUtility.UrlDecode(kv[1]);
            }
            return dict;
        }
    }
