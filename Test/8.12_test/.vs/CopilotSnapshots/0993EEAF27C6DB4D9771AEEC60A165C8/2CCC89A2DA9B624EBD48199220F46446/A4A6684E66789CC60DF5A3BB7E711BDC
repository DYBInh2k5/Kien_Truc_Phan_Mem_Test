class ChatBuilder
{
    private string html = "";

    public ChatBuilder setTitle(string title)
    {
        html += $"<h1>{title}</h1>";
        return this;
    }

    public ChatBuilder addMessage(string msg)
    {
        html += $"<p>{msg}</p>";
        return this;
    }

    public string build()
    {
        return html;
    }
}
